PRODUCT_BUNDLE_IDENTIFIER = jp.ouchi.maintenance
IOS_SANDBOX_BILLING = NO
#include? "Local.xcconfig"
INFOPLIST_KEY_IOS_SANDBOX_BILLING = $(IOS_SANDBOX_BILLING)
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1,2
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = おうちメンテ
INFOPLIST_KEY_SUPABASE_URL = https:/$()/$(SUPABASE_PROJECT_REF).supabase.co
INFOPLIST_KEY_SUPABASE_PUBLISHABLE_KEY = $(SUPABASE_PUBLISHABLE_KEY)
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
CODE_SIGN_STYLE = Automatic
